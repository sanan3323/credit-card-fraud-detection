# AWS Lambda container image: the same app, wrapped by Mangum, on the Lambda
# Python base image. Deployed behind API Gateway via infra/template.yaml (SAM).
# Lambda scales to zero, so an idle demo endpoint costs ~$0/month.
FROM public.ecr.aws/lambda/python:3.12

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY src ./src
COPY artifacts/fraud_model_artifact.pkl ./artifacts/fraud_model_artifact.pkl

# Lambda invokes this handler (Mangum adapts the ASGI FastAPI app to Lambda events).
CMD ["src.service.app.handler"]
